{
  "info": {
    "_postman_id": "dd4af11f-502e-4a19-b9bd-46f8ef04d4f9",
    "name": "Strapi Admin Panel Admin Authentication API",
    "description": "The Strapi Admin Panel API powers the back-office interface used to manage content-types, content entries, media assets, and administrator accounts. It provides endpoints for the Content-Type Builder, Content Manager, Media Library, and role-based access control configuration. The API supports three default administrator roles (Super Admin, Editor, and Author) with granular permission management, allowing organizations to control which administrative functions each role can access.\n\nContact Support:\n Name: Strapi Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T01:19:58.000Z",
    "updatedAt": "2026-10-22T01:19:58.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-dd4af11f-502e-4a19-b9bd-46f8ef04d4f9"
  },
